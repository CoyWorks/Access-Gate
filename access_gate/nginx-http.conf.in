server {
    listen @@LISTEN@@:80;
    server_name @@NAMES@@;
    include /etc/access-gate/client-networks.nginx;
    location = /setup/bootstrap {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Gate-Key "";
        access_log off;
    }
    location = /ca.crt {
        root /var/lib/access-gate/public;
        default_type application/x-x509-ca-cert;
        add_header Cache-Control no-store;
    }
    location ~ ^/(domains\.txt|pihole\.conf)$ {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Gate-Key "";
        access_log off;
    }
    # API HTTP requests are rejected as JSON by the trusted backend, never redirected.
    location ~ ^/api/v1(?:/|$) {
        allow all;
        client_max_body_size 16k;
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Gate-HTTPS "0";
        proxy_set_header X-Gate-Key "";
        proxy_set_header Authorization $http_authorization;
        proxy_intercept_errors off;
        error_page 413 = @api_body_limit;
        error_page 502 504 = @api_unavailable;
        access_log off;
    }
    location @api_body_limit {
        internal;
        default_type application/json;
        add_header Cache-Control no-store always;
        add_header X-Request-ID $request_id always;
        return 413 '{"request_id":"$request_id","error":{"code":"request_too_large","message":"The request body is too large.","details":[]}}';
    }
    location @api_unavailable {
        internal;
        default_type application/json;
        add_header Cache-Control no-store always;
        add_header X-Request-ID $request_id always;
        add_header Retry-After 60 always;
        return 503 '{"request_id":"$request_id","error":{"code":"service_unavailable","message":"The API is temporarily unavailable.","details":[]}}';
    }
    location / {
        proxy_pass http://127.0.0.1:8089;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Gate-Key "";
    }
}
