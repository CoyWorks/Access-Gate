# Alternative manual gateway from 0.4; do not enable alongside the built-in 0.5 gateway.
# Replace example.org, its certificate/key paths and REPLACE_WITH_ACL_TOKEN.
# Never deploy this file unchanged. Keep the selected DNS policy consistent and
# keep /internal/ on the portal unreachable by clients. This example has no dynamic TLS.
server {
    listen 10.40.22.5:443 ssl;
    server_name example.org;
    if ($host != example.org) { return 444; }
    ssl_certificate /etc/access-gate/gateway/example.org.crt;
    ssl_certificate_key /etc/access-gate/gateway/example.org.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    include /etc/access-gate/client-networks.nginx;
    access_log off;
    # Resolve the real origin independently of the Pi-hole rewrite to this VM.
    resolver 1.1.1.1 9.9.9.9 valid=60s ipv6=off;
    resolver_timeout 3s;

    location = /_access_gate_auth {
        internal;
        proxy_pass http://127.0.0.1:8088/internal/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Gate-Key REPLACE_WITH_ACL_TOKEN;
        proxy_set_header X-Gate-Origin https://$host;
        proxy_set_header Cookie $http_cookie;
    }

    location @access_gate_login {
        rewrite ^ /internal/start? break;
        proxy_pass http://127.0.0.1:8088;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Gate-Key REPLACE_WITH_ACL_TOKEN;
        proxy_set_header X-Gate-Origin https://$host;
    }

    location = /__access_gate/complete {
        proxy_pass http://127.0.0.1:8088/internal/finish;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Gate-Key REPLACE_WITH_ACL_TOKEN;
        proxy_set_header X-Gate-Origin https://$host;
        proxy_set_header Cookie $http_cookie;
    }

    location / {
        auth_request /_access_gate_auth;
        auth_request_set $access_gate_cookies $upstream_http_x_gate_upstream_cookie;
        error_page 401 = @access_gate_login;
        proxy_set_header Host $host;
        proxy_set_header Cookie $access_gate_cookies;
        proxy_set_header X-Gate-Key "";
        proxy_ssl_server_name on;
        proxy_ssl_name $host;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 5;
        proxy_pass https://$host$request_uri;
    }
}
